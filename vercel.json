{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/apps/api/index.js"
    },
    {
      "source": "/recruiter/(.*)",
      "destination": "/recruiter/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
