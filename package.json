{
  "name": "careerbridge-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:seeker": "npm run dev -w seeker",
    "dev:recruiter": "npm run dev -w recruiter",
    "dev:api": "npm run dev -w api",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:seeker\" \"npm run dev:recruiter\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "gh-pages": "^6.3.0"
  }
}
