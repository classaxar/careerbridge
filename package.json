{
  "name": "careerbridge-unified",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "npm run build -w web",
    "build:api": "npm run build -w api"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
